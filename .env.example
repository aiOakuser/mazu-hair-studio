# SMTP credentials for outgoing mail (contact form, booking-by-email fallback).
# Same account used by the Global Designer Hub Django platform on this box.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Optional: defaults to EMAIL_HOST_USER if unset.
EMAIL_FROM=

# Where contact/booking-inquiry emails are delivered. Defaults to
# business.email (src/data/business.ts) if unset.
CONTACT_EMAIL_TO=
